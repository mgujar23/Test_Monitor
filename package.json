{
  "name": "test-monitor",
  "version": "1.0.0",
  "description": "Professional test monitoring dashboard",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --watch server.js",
    "dev": "node --watch server.js",
    "dev:ui": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:backend": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/backend",
    "test:frontend": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/frontend",
    "test:ui": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/ui",
    "test:utils": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/utilities",
    "test:api": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/backend/api.test.js",
    "test:diff": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/backend/diff-generation.test.js",
    "test:section": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/frontend/Section.test.jsx",
    "test:modal": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/frontend/DiffModal.test.jsx"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "node-cron": "^3.0.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.0",
    "jest": "^29.7.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.1.0",
    "identity-obj-proxy": "^3.0.0"
  }
}
